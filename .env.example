# Account API key da plataforma thesain26 na Whop.
# Ela cria connected accounts, account links, checkouts e lê saldo.
WHOP_API_KEY=

# Segredo ws_... do webhook criado no dashboard da Whop.
# O endpoint é POST /api/webhooks/whop
WHOP_WEBHOOK_SECRET=

# PostgreSQL. Na Render, use a Internal Database URL do banco thesain26_db.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thesain26_db?schema=public"

# Segredo do Auth.js / NextAuth (sessão JWT).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:43123

# URL pública da thesain26. Account Links voltam para cá.
# Em produção precisa ser https para o redirect_url do checkout.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Dono da plataforma, criado pelo seed.
PLATFORM_OWNER_EMAIL=dono@thesain26.com
PLATFORM_OWNER_PASSWORD=thesain26-dono
PLATFORM_OWNER_NAME="Dono thesain26"

# IA da xAI. Monta o produto em /painel/produtos/novo a partir de um texto.
# Na Render, crie a variável XAI_API_KEY com a sua chave. Não commite a chave.
XAI_API_KEY=
XAI_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-3-mini
