generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Vendedor da thesain26 ou o dono da plataforma.
/// whopBizId é o id da Connected Account (biz_...) criada na Whop.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               String    @default("seller")
  whopBizId          String?   @unique
  kycStatus          String    @default("not_started")
  kycDetail          String?
  kycCheckedAt       DateTime?
  /// active | suspended, lido de accounts.retrieve na Whop.
  accountStatus      String    @default("active")
  feePercentOverride Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store    Store?
  products Product[]
  sales    Sale[]
}

model Store {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  slug         String   @unique
  description  String   @default("")
  logoUrl      String?
  primaryColor String   @default("#16382c")
  accentColor  String   @default("#0f6e56")
  published    Boolean  @default(true)
  /// Site principal (https). A Whop recebe este valor em accounts.update website.
  website      String?
  /// Rede ou site informado no cadastro, mesmo quando não é um site genérico.
  socialUrl    String?
  instagram    String?
  youtube      String?
  linkedin     String?
  /// Chave interna (education, mentorship, …). O código da Whop é mapeado na hora do sync.
  businessType String   @default("digital_product")
  industryType String   @default("knowledge_business")
  /// ISO 3166-1 alpha-2. A Whop espera o país neste formato.
  country      String   @default("BR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
}

model Product {
  id                   String   @id @default(cuid())
  storeId              String
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId             String
  seller               User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name                 String
  subtitle             String   @default("")
  description          String   @default("")
  /// mentoria_1_1, curso, comunidade, software, ebook, consultoria, assinatura, outro
  productType          String   @default("outro")
  /// manual, email, community, download
  deliveryMethod       String   @default("manual")
  price                Float
  currency             String   @default("usd")
  imageUrl             String?
  /// Atalho opcional. O checkout canônico continua /checkout/[id].
  slug                 String?  @unique
  /// active | draft. `active` espelha este campo para a vitrine pública.
  status               String   @default("active")
  whopPlanId           String?
  whopCheckoutId       String?
  whopPurchaseUrl      String?
  applicationFeeAmount Float?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  prices ProductPrice[]
  sales  Sale[]
}

/// Opção extra de preço. Cada uma tem a própria Checkout Configuration (Direct Charge).
model ProductPrice {
  id                   String   @id @default(cuid())
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label                String   @default("")
  amount               Float
  currency             String   @default("usd")
  whopPlanId           String?
  whopPurchaseUrl      String?
  applicationFeeAmount Float?
  createdAt            DateTime @default(now())
}

/// Venda registrada pelo webhook da Whop (ou pela sincronização manual).
model Sale {
  id             String   @id @default(cuid())
  whopPaymentId  String   @unique
  sellerId       String?
  seller         User?    @relation(fields: [sellerId], references: [id])
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  buyerEmail     String?
  amount         Float
  applicationFee Float    @default(0)
  currency       String   @default("usd")
  status         String
  whopAccountId  String?
  createdAt      DateTime @default(now())
}

model PlatformSettings {
  id         String @id @default("platform")
  feePercent Float  @default(5)
  name       String @default("thesain26")
}

/// Idempotência dos webhooks (o header webhook-id).
model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
